{
  "$id": "urn:qsa:schema:known-answer-inputs:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_count": {
      "const": 24
    },
    "context_profile": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "const": "known_answer_input_16x16"
        },
        "master_key_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "nonce_domain_ascii": {
          "const": "QSA-KNOWN-ANSWER-NONCE-V1"
        },
        "protocol_id": {
          "const": "QSA-KNOWN-ANSWER-V1"
        },
        "public_material_domain_ascii": {
          "const": "QSA-KNOWN-ANSWER-PUBLIC-MATERIAL-V1"
        },
        "public_metadata": {
          "additionalProperties": false,
          "properties": {
            "benchmark": {
              "const": "QSA-KNOWN-ANSWER-V1"
            },
            "metadata_profile": {
              "const": "fixed-reference-v1"
            },
            "object_semantics": {
              "const": "complete-public-object"
            },
            "schema": {
              "const": 1
            }
          },
          "required": [
            "benchmark",
            "metadata_profile",
            "object_semantics",
            "schema"
          ],
          "type": "object"
        },
        "run_id_template": {
          "const": "known-answer|{method_id}"
        },
        "seed_domain_ascii": {
          "const": "QSA-KNOWN-ANSWER-SEED-V1"
        }
      },
      "required": [
        "protocol_id",
        "image_id",
        "run_id_template",
        "master_key_hex",
        "public_metadata",
        "nonce_domain_ascii",
        "seed_domain_ascii",
        "public_material_domain_ascii"
      ],
      "type": "object"
    },
    "input": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "const": 768
        },
        "dtype": {
          "const": "uint8"
        },
        "generator_id": {
          "const": "coordinate-mix-v1"
        },
        "layout": {
          "const": "C-order RGB"
        },
        "relative_path": {
          "const": "reference/known_answers/input.rgb"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "shape": {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": 16
            },
            {
              "const": 16
            },
            {
              "const": 3
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "relative_path",
        "shape",
        "dtype",
        "layout",
        "byte_length",
        "generator_id",
        "sha256"
      ],
      "type": "object"
    },
    "method_order": {
      "items": {
        "pattern": "^B[0-9]{2}_[a-z0-9_]+$",
        "type": "string"
      },
      "maxItems": 24,
      "minItems": 24,
      "type": "array",
      "uniqueItems": true
    },
    "method_profile": {
      "const": "extended"
    },
    "object_format": {
      "additionalProperties": false,
      "properties": {
        "magic_ascii": {
          "const": "QSB1"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "magic_ascii",
        "version"
      ],
      "type": "object"
    },
    "operational_use_prohibited": {
      "const": true
    },
    "public_test_values": {
      "const": true
    },
    "reference_set_id": {
      "const": "QSA-KNOWN-ANSWER-SET-V1"
    },
    "schema_id": {
      "const": "urn:qsa:schema:known-answer-inputs:v1"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "reference_set_id",
    "method_profile",
    "case_count",
    "method_order",
    "input",
    "context_profile",
    "object_format",
    "public_test_values",
    "operational_use_prohibited"
  ],
  "title": "Fixed known-answer input and context configuration",
  "type": "object"
}
